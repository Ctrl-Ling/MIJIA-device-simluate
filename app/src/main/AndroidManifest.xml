<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：App 内「同步米家目录」要读米家 APK 自带的 assets -->
    <queries>
        <package android:name="com.xiaomi.smarthome" />
    </queries>

    <!-- 从 miot-spec.org 拉取型号 spec（Phase 0 素材扩充）-->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MijiaSim">

        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!--
          配置单一数据源。Hook 代码跑在米家进程里，读不到本模块的私有目录，
          所以对外用 ContentProvider 暴露 config / state / spec 三类数据；
          管理界面写、米家进程读，改完 notifyChange 让注入侧立刻重载，不用重编模块。
        -->
        <provider
            android:name="com.mijia.devicesim.provider.ConfigProvider"
            android:authorities="@string/provider_authority"
            android:directBootAware="false"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 主管理界面：桌面图标 + 设备列表 -->
        <activity
            android:name="com.mijia.devicesim.ui.MainActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 添加/编辑向导 -->
        <activity
            android:name="com.mijia.devicesim.ui.DeviceEditActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="@string/title_edit_device"
            android:parentActivityName="com.mijia.devicesim.ui.MainActivity" />

        <!-- 型号库：浏览 / 搜索 / 导入 spec -->
        <activity
            android:name="com.mijia.devicesim.ui.ModelLibraryActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="@string/title_model_library"
            android:parentActivityName="com.mijia.devicesim.ui.MainActivity" />

        <!-- 设备详情：型号库 68 个原始字段 + 产品大图 -->
        <activity
            android:name="com.mijia.devicesim.ui.DeviceDetailActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="@string/title_device_detail"
            android:parentActivityName="com.mijia.devicesim.ui.MainActivity" />

        <!-- 实时调试面板：属性状态 + 最近调用记录 + 钩子命中报告 -->
        <activity
            android:name="com.mijia.devicesim.ui.DebugActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="@string/title_debug_panel"
            android:parentActivityName="com.mijia.devicesim.ui.MainActivity" />

    </application>

</manifest>
