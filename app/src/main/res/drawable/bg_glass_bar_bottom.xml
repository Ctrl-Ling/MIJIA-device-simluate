<!-- 底部操作条玻璃：上缘两角大圆角浮起来，顶部一根发丝线，左右缩进别切到圆角。-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/bar_top"
                android:startColor="@color/bar_bottom" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
        </shape>
    </item>

    <item
        android:height="1dp"
        android:left="28dp"
        android:right="28dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_stroke" />
        </shape>
    </item>

</layer-list>
