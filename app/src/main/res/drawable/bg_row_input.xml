<!--
  首页设备行：皮肤照搬编辑页输入框（半透白底 + 1dp 高光描边，按下更白），
  圆角仍用行自己的 18dp，不改成通圆药丸。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_pressed" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_fill" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
