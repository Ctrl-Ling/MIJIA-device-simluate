<!--
  编辑页表单卡：形状跟主卡片一致（26dp 圆角 + 1dp 高光），但白色压得更淡。
  原来用 bg_glass_card（90%→60% 白），嵌在里面同样是半透白的输入框和药丸按钮
  就完全糊在背景里；把大块面降到 65%→24%，小控件才立得起来。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_card_faint_bottom"
        android:startColor="@color/glass_card_faint_top" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
