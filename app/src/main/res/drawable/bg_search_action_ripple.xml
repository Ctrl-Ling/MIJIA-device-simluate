<!-- 搜索玻璃条右端的点击波纹：左侧方角、右侧跟药丸同弧，波纹不会戳出圆角外。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/row_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/row_pressed" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="99dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="99dp" />
        </shape>
    </item>
</ripple>
