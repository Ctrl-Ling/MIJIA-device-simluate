<!--
  状态块标题行的按压反馈：ripple 用 mask 收进「上面两角 26dp 圆角」的形状里，
  跟卡片圆角对齐。原来用 ?attr/selectableItemBackground 是矩形波纹，
  按下时四角是方的，看着像卡片底下多了一块矩形阴影。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/row_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
</ripple>
