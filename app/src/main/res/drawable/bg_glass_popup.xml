<!--
  顶栏三点菜单的弹出层：外圈留 6dp 给阴影呼吸，里面是一块不透明的白卡
  （上纯白、下极浅冷白，20dp 圆角 + 1dp 淡墨描边）。inset 同时把菜单内容
  的排版往里推，文字不会贴着圆角切边。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="6dp"
    android:insetLeft="6dp"
    android:insetRight="6dp"
    android:insetTop="6dp">
    <shape android:shape="rectangle">
        <gradient
            android:angle="270"
            android:endColor="@color/popup_bottom"
            android:startColor="@color/popup_top" />
        <corners android:radius="20dp" />
        <stroke
            android:width="1dp"
            android:color="@color/glass_divider" />
    </shape>
</inset>
