<!-- 排序指示：倒序。下箭头墨色实权，上箭头淡下去；尺寸固定 12dp，不随方向变宽。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="12dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 上箭头：另一半方向，淡下去 -->
    <path
        android:pathData="M7,12 L12,6.5 L17,12"
        android:strokeColor="#4D5C6B7A"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 下箭头：当前排序方向，实心墨色 -->
    <path
        android:pathData="M7,12 L12,17.5 L17,12"
        android:strokeColor="#FF1B1F24"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
