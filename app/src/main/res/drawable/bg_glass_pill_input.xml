<!--
  编辑页输入框：跟首页「新增设备」药丸按钮同一套皮肤 ——
  全圆角、半透白底、1dp 高光描边；聚焦时描边转主题绿，一眼看出在改哪一格。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_fill" />
            <corners android:radius="99dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_disabled" />
            <corners android:radius="99dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_fill" />
            <corners android:radius="99dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
