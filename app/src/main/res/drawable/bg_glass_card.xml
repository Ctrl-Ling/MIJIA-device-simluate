<!-- 主毛玻璃卡片：上半透白、下半更透，1dp 高光描边，28dp 大圆角。-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_bottom"
        android:startColor="@color/glass_top" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
