<!--
  状态块展开态：底、白描边、99dp 全圆角跟收起态的药丸一模一样，
  只是高度随诊断文字长高。文字四边留白按胶囊内侧收（左右 24dp、底 18dp），
  多行文字两头才不会被圆弧压到描边上。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pill_fill" />
    <corners android:radius="99dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
