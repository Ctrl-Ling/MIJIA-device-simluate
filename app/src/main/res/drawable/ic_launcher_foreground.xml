<?xml version="1.0" encoding="utf-8"?>
<!--
  Author: Ctrl-Ling
  Last Modified By: Ctrl-Ling
  Last Modified At: 2026-11-11 20:12:21 +08:00

  米家风格的前景：一只实心白灯泡（设备本体）压在米家绿瓷砖上，
  灯肚里一枚同色绿勾，表示「这台设备是模拟出来的、状态已验证」。
  全部内容落在 108 画布中央 66dp 安全区内，圆/方/泪滴遮罩都不会切到。
  单色层复用这张图：系统只会取它的透明度，勾会和灯肚同色，退化成一个干净的灯泡剪影。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 灯肚：从正圆肩部收窄到灯颈 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,27a18,18 0 0 1 10.6,32.6c-1.3,1 -2.1,2.4 -2.4,4l-0.7,5.4h-15l-0.7,-5.4c-0.3,-1.6 -1.1,-3 -2.4,-4A18,18 0 0 1 54,27z" />

    <!-- 灯头两道 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M49,73h12a2.5,2.5 0 0 1 2.5,2.5v0.5a2.5,2.5 0 0 1 -2.5,2.5h-12a2.5,2.5 0 0 1 -2.5,-2.5v-0.5a2.5,2.5 0 0 1 2.5,-2.5z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52,80.5h4a2,2 0 0 1 2,2v0.5a2,2 0 0 1 -2,2h-4a2,2 0 0 1 -2,-2v-0.5a2,2 0 0 1 2,-2z" />

    <!-- 灯肚里的绿勾 -->
    <path
        android:pathData="M47.5,45l4.5,5.5l9,-11"
        android:strokeColor="#FF12A06A"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
