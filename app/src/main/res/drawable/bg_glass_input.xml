<!-- 输入框：半透白 + 18dp 圆角，聚焦时描边转成主题绿，眼一眼就知道在输入哪一格。-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_input_fill" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_input_fill" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_soft" />
        </shape>
    </item>
</selector>
