<!--
  首页设备列表容器：配色/描边照搬编辑页那张表单卡（65%→24% 白渐变 + 1dp 高光），
  只有圆角按列表块自己的 22dp，保持原来的轮廓。
  大块面压淡之后，嵌在里面的半透白行才立得起来。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_card_faint_bottom"
        android:startColor="@color/glass_card_faint_top" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
