<!-- 主操作药丸（保存/确定）：绿色渐变底，白字；按下压暗，禁用变灰玻璃。-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/primary_pressed_to"
                android:startColor="@color/primary_pressed_from" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_disabled" />
            <corners android:radius="99dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/primary_to"
                android:startColor="@color/primary_from" />
            <corners android:radius="99dp" />
        </shape>
    </item>
</selector>
