<resources>
    <color name="accent">#FF2bb673</color>
    <!-- 设备行标题按接入类型上色：WiFi 绿 / 蓝牙与蓝牙 Mesh 蓝 / Zigbee 紫 / 网关橙。
         色值都压过明度，16sp 粗体压在浅色玻璃上也读得清。 -->
    <color name="type_wifi">#FF1E8E5A</color>
    <color name="type_ble">#FF1E6FD9</color>
    <color name="type_mesh">#FF2E7BE6</color>
    <color name="type_zigbee">#FF7B3FC1</color>
    <color name="type_gateway">#FFCB6A12</color>
    <color name="offline">#FF9E9E9E</color>
    <color name="call_get">#FF1565C0</color>
    <color name="call_set">#FFC62828</color>
    <color name="call_action">#FF6A1B9A</color>

    <!-- 界面用：状态横幅底色、拖拽把手颜色 -->
    <color name="status_bg">#22888888</color>
    <color name="drag_handle">#88000000</color>

    <!-- ===== 液态玻璃：底色 =====
         底部不再是一片白：底部用偏冷的雾蓝（liquid_sky），越往上越亮（liquid_mist），
         再压一层底部到 45% 高度渐隐的 depth 色，保证列表压到底部时文字有底可依。 -->
    <color name="liquid_sky">#FFD8E7F2</color>
    <color name="liquid_mist">#FFF1F8F5</color>
    <color name="liquid_depth">#3987A9BC</color>
    <color name="blob_mint">#552BB673</color>
    <color name="blob_blue">#4D4C9AFF</color>
    <color name="blob_violet">#4D8E7CFF</color>
    <color name="blob_amber">#3BF2A33C</color>

    <!-- ===== 液态玻璃：卡片 ===== -->
    <color name="glass_top">#E6FFFFFF</color>
    <color name="glass_bottom">#99FFFFFF</color>
    <color name="glass_soft">#66FFFFFF</color>
    <!-- 编辑页大卡片：白得更淡，好让嵌在里面的输入框/按钮显出边界 -->
    <color name="glass_card_faint_top">#A6FFFFFF</color>
    <color name="glass_card_faint_bottom">#3DFFFFFF</color>
    <color name="glass_stroke">#80FFFFFF</color>
    <color name="glass_stroke_soft">#4DFFFFFF</color>

    <!-- ===== 液态玻璃：控件 ===== -->
    <color name="pill_fill">#80FFFFFF</color>
    <color name="pill_pressed">#B3FFFFFF</color>
    <color name="pill_disabled">#40FFFFFF</color>
    <color name="glass_input_fill">#8CFFFFFF</color>
    <color name="row_fill">#1FFFFFFF</color>
    <color name="row_pressed">#59FFFFFF</color>
    <color name="dialog_fill">#F7FFFFFF</color>
    <color name="bar_top">#F2FFFFFF</color>
    <color name="bar_bottom">#D9FFFFFF</color>
    <!-- 三点菜单弹出层：完全不透明白，压在列表上也读得清字 -->
    <color name="popup_top">#FFFFFFFF</color>
    <color name="popup_bottom">#FFF6FAFF</color>

    <!-- ===== 液态玻璃：文字与主色 ===== -->
    <color name="ink">#FF1B1F24</color>
    <color name="ink_muted">#FF5C6B7A</color>
    <color name="accent_deep">#FF17794A</color>
    <color name="primary_from">#FF3ACB8C</color>
    <color name="primary_to">#FF1E9C68</color>
    <color name="primary_pressed_from">#FF2FB77C</color>
    <color name="primary_pressed_to">#FF178557</color>
    <color name="button_text_disabled">#8A5F6B7A</color>
    <color name="button_text_primary_disabled">#99FFFFFF</color>
    <!-- 详情页字段行之间的发丝线：白底玻璃上要淡墨色才看得见 -->
    <color name="glass_divider">#14000000</color>

    <!-- ===== 开关 =====
         关闭态不再跟系统走的深灰/近黑：整屏都是浅色玻璃，一颗黑药丸压在上面太重。
         轨道用浅灰、圆点用近白，边界靠描边感的白圆点跟灰轨道拉开；打开才亮成主色绿。 -->
    <color name="switch_track_off">#9ED2D8DD</color>
    <color name="switch_track_on">#4D2BB673</color>
    <color name="switch_thumb_off">#FFFDFEFE</color>
    <color name="switch_thumb_on">#FF2BB673</color>
</resources>
