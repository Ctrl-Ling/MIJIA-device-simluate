<resources>

    <!--
      液态玻璃：固定走浅色，不跟系统深色模式翻。
      理由：玻璃卡片靠「透出底下色斑」撑视觉，深色底下这套半透白全糊成灰的；
      先把这个设计做对，再谈深色版。
    -->
    <style name="Theme.MijiaSim" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent_deep</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorAccent">@color/accent_deep</item>

        <item name="android:colorBackground">@color/liquid_sky</item>
        <item name="android:windowBackground">@drawable/bg_liquid</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:textColorHint">@color/ink_muted</item>

        <!-- 系统栏透明，让底下的色斑一直铺到屏幕边 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- 顶栏也做成一层玻璃，标题深字、⋮ 图标跟着变深 -->
        <item name="actionBarStyle">@style/Widget.MijiaSim.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MijiaSim.ActionBar</item>
        <!-- 顶栏压到默认 56dp 的 2/3 ≈ 37dp，省出来的高度全给内容区 -->
        <item name="actionBarSize">37dp</item>
        <item name="android:actionBarSize">37dp</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MijiaSim.Dialog</item>

        <!-- 三点菜单弹出层同样走玻璃：半透白卡 + 深字，不再是一块直角白板 -->
        <item name="actionOverflowMenuStyle">@style/Widget.MijiaSim.PopupMenu.Overflow</item>
        <item name="popupMenuStyle">@style/Widget.MijiaSim.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.MijiaSim.PopupMenuItem</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.MijiaSim.PopupMenuItem</item>
    </style>

    <!--
      顶栏不再铺一块白板：背景全透明，直接透出窗口的液态底色，
      标题就像浮在背景上，跟内容区没有任何一道分界线。
      内容区本来就不从顶栏下面经过，透明不会让列表透上来。
    -->
    <style name="Widget.MijiaSim.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <!-- 标题/返回箭头跟正文卡片左缘对齐（正文 14dp） -->
        <item name="contentInsetStart">14dp</item>
        <item name="titleTextStyle">@style/TextAppearance.MijiaSim.ActionBar.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.MijiaSim.ActionBar.Subtitle</item>
    </style>

    <style name="TextAppearance.MijiaSim.ActionBar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.MijiaSim.ActionBar.Subtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="ThemeOverlay.MijiaSim.ActionBar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorControlNormal">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="ThemeOverlay.MijiaSim.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="colorControlNormal">@color/ink_muted</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorAccent">@color/accent_deep</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
    </style>

    <!-- 三点菜单弹出层：背景换成内缩 6dp 的玻璃卡（圆角/描边在 drawable 里），
         轻微抬升出阴影；不压在 ⋮ 上，往下错开一点，像从按钮底下浮出来。 -->
    <style name="Widget.MijiaSim.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_glass_popup</item>
        <item name="android:popupElevation">10dp</item>
    </style>

    <style name="Widget.MijiaSim.PopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_glass_popup</item>
        <item name="android:popupElevation">10dp</item>
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
    </style>

    <!-- 菜单文字：深墨色、14sp，跟正文一致 -->
    <style name="TextAppearance.MijiaSim.PopupMenuItem" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 药丸按钮：所有次级操作都用它。
         backgroundTint 必须显式置空：父样式 Widget.AppCompat.Button 带着
         「?attr/colorButtonNormal」的着色，会把半透白玻璃整个染成实心绿，
         按钮看着就是大色块。置空后才是真正透出底色的液态玻璃。 -->
    <style name="Widget.MijiaSim.Button.Pill" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_glass_pill</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 主操作药丸：保存 / 确定这类"往下走"的动作。
         底色、高度、字号一律跟 Pill 一样，只用加粗字重区分主次 ——
         不再铺实色渐变，避免整屏按钮一片绿。 -->
    <style name="Widget.MijiaSim.Button.Primary" parent="Widget.MijiaSim.Button.Pill">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 危险操作药丸：删除，字色走红 -->
    <style name="Widget.MijiaSim.Button.Danger" parent="Widget.MijiaSim.Button.Pill">
        <item name="android:textColor">@color/call_set</item>
    </style>

</resources>
