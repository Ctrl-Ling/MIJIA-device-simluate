<!--
  设备行：皮肤跟编辑页输入框同一套（半透白 + 1dp 高光描边，按下更白），
  圆角保留行自己的 18dp，不改成通圆药丸。
  设备名允许折两行（超了第二行尾部省略）；第二行是型号/房间，第三行 did，
  第四行接入类型 —— 类型不再塞在型号行里。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_row_input"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingLeft="6dp"
    android:paddingRight="4dp">

    <!-- 按住这里才会进入拖拽排序：整行长按留给「复制 / 删除 / 重置状态」菜单 -->
    <!-- 行尾那一排（拖拽条 / 三点 / 开关）尽量收窄，宽度全让给设备名与型号 -->
    <TextView
        android:id="@+id/drag_handle"
        android:layout_width="28dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/drag_handle_glyph"
        android:textColor="@color/drag_handle"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="2dp">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/device_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/device_did"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="monospace"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <!-- 接入类型跟在 did 后面单独一行，颜色仍按类型走；did 是等宽 32 位，
             挤在同一行会被省略号吃掉，所以另起一行。 -->
        <TextView
            android:id="@+id/device_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/online_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="2dp"
        android:textSize="12sp" />

    <!-- 行尾三点：和长按整行弹的是同一个菜单，手短也够得着 -->
    <TextView
        android:id="@+id/device_more"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/action_more"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/action_more_glyph"
        android:textColor="@color/ink_muted"
        android:textSize="20sp" />

    <!-- 开关本体是固定 intrinsic 尺寸，直接改 layout_width 会被它自己量回去，
         所以套一层定宽容器 + 缩放：视觉小一圈，命中区还是整块 48dp 高 -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="48dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/device_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:scaleX="0.82"
            android:scaleY="0.82"
            android:transformPivotX="0dp"
            android:transformPivotY="24dp" />
    </FrameLayout>

</LinearLayout>
