<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">

    <!-- 按住这里才会进入拖拽排序：整行长按留给「复制 / 删除 / 重置状态」菜单 -->
    <TextView
        android:id="@+id/drag_handle"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/drag_handle_glyph"
        android:textColor="@color/drag_handle"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/device_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/device_did"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/online_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="6dp"
        android:textSize="12sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/device_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
