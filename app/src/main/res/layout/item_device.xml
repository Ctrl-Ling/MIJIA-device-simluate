<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_row_glass"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <!-- 按住这里才会进入拖拽排序：整行长按留给「复制 / 删除 / 重置状态」菜单 -->
    <TextView
        android:id="@+id/drag_handle"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/drag_handle_glyph"
        android:textColor="@color/drag_handle"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/device_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/device_did"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="monospace"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/online_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="4dp"
        android:textSize="12sp" />

    <!-- 行尾三点：和长按整行弹的是同一个菜单，手短也够得着 -->
    <TextView
        android:id="@+id/device_more"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/action_more"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/action_more_glyph"
        android:textColor="@color/ink_muted"
        android:textSize="20sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/device_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
