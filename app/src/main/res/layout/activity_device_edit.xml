<!--
  外层不滚动：上面是表单 + 属性列表的滚动区（layout_weight=1），
  下面固定一行保存/取消。属性再多页也压不动按钮。
  表单整体是一张毛玻璃卡片，输入框是嵌在卡里的小玻璃砖，聚焦时描边亮绿。
  卡片到标题栏只留 5dp 缝，卡片与底部按钮同宽（左右 12dp），一眼是一整页而不是几块拼起来的。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
      卡片框固定：滚动只发生在圆角矩形内部。
      原来卡片自己跟着 ScrollView 上下跑，往上滑时卡片上缘会从标题栏下面溜走，
      下缘又钻进底部操作条，两头都像两块东西硬拼在一起；现在边框钉死，只滚里面的内容。
      顶边距压到 5dp：标题栏和卡片之间不再挂一条 12dp 的空缝，视觉上直接贴住。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card_faint"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/edit_did"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="@string/label_name"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_name"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_pill_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/label_model"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_model"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_model"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="44dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted" />

                <Button
                    android:id="@+id/btn_pick_model"
                    style="@style/Widget.MijiaSim.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_pick_model" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/label_type"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 类型下拉：跟输入框同款药丸皮肤；Spinner 自己画不出箭头，右边盖一个 ▾ -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill_input">

                    <Spinner
                        android:id="@+id/spinner_type"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@null"
                        android:paddingStart="16dp"
                        android:paddingEnd="34dp" />

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="@string/status_arrow_open"
                        android:textColor="@color/ink_muted"
                        android:textSize="14sp" />
                </FrameLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_online"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_online" />
            </LinearLayout>

            <TextView
                android:id="@+id/label_parent_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/label_parent_gateway"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/parent_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_parent_did"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill_input"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_parent_did"
                    android:inputType="number"
                    android:maxLines="1"
                    android:minHeight="44dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted" />

                <Button
                    android:id="@+id/btn_pick_parent"
                    style="@style/Widget.MijiaSim.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_pick_gateway" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/label_room"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_room"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_pill_input"
                android:gravity="center_vertical"
                android:hint="@string/hint_room"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/input_token"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill_input"
                    android:gravity="center_vertical"
                    android:fontFamily="monospace"
                    android:hint="@string/label_token"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:minHeight="44dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_token"
                    style="@style/Widget.MijiaSim.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_random" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/input_mac"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill_input"
                    android:gravity="center_vertical"
                    android:fontFamily="monospace"
                    android:hint="@string/label_mac"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:minHeight="44dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_mac"
                    style="@style/Widget.MijiaSim.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_random" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/glass_stroke_soft" />

            <TextView
                android:id="@+id/spec_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <!-- spec 是什么，说人话；第一次用的人不该猜这个词 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/hint_spec_what"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_fetch_spec"
                    style="@style/Widget.MijiaSim.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textSize="14sp"
                    android:text="@string/action_fetch_spec_online" />

                <Button
                    android:id="@+id/btn_reset_state"
                    style="@style/Widget.MijiaSim.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_reset_state" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/label_props"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/prop_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 底部就是一行两颗简单按钮，不再垫一整条玻璃浮层：
         垫了背景之后按钮四周多出一圈白边，跟上面的卡片像两块硬拼的东西。
         左右 12dp 跟卡片对齐，上下留一点呼吸；按钮尺寸/圆角/皮肤全部沿用型号库那套。
         取消在左、保存在右：往右是"继续"，符合安卓一贯的阅读方向；两者间距 8dp 跟型号库同一档。 -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- 跟型号库按钮同一套：44dp 高、18dp 圆角、半透白底 + 1dp 淡描边 -->
        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input_button"
            android:text="@string/action_cancel"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.MijiaSim.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input_button"
            android:text="@string/action_save"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
