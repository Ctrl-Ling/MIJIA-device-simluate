<!-- 液态玻璃版调试面板：状态横幅、实时属性、调用记录各占一块玻璃。-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/debug_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_soft"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_refresh"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_refresh" />

        <Button
            android:id="@+id/btn_clear_log"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_clear_calls" />

        <Button
            android:id="@+id/btn_dump"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_dump_debug" />
    </LinearLayout>

    <TextView
        android:id="@+id/report_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/report_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="10"
        android:scrollbars="vertical"
        android:textColor="@color/ink_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="@string/title_live_state"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/live_state_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_tap_prop"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card_soft"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="@string/title_recent_calls"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_log_list"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_card_soft"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:scrollbars="vertical"
        android:textColor="@color/ink_muted"
        android:textSize="11sp" />

</LinearLayout>
