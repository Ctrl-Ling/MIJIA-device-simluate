<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_model_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_model_search"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_search_online"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_search_online" />
    </LinearLayout>

    <!-- 分类：两级下拉，当前选中项写在按钮上，不再铺两排 chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="6dp"
            android:text="@string/label_cat"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_pick_cat"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:text="@string/filter_all_cats"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_pick_sub"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:text="@string/filter_pick_cat_first"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 品牌：跟分类一样一颗下拉按钮，当前筛了谁写在按钮上；点开是全量多选弹窗 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="6dp"
            android:text="@string/label_brand"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_pick_brand"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:text="@string/filter_all_brands"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 目录同步、导入导出、排序这些都在右上角三点菜单里；这行只留状态提示，省下来的高度全给列表 -->
    <TextView
        android:id="@+id/library_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <!-- 型号列表排序：默认是品牌→名称，其余按名称/上市时间重排当前结果 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:text="@string/label_sort"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_default"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_default"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_name"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_name"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_time"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_time"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/model_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/online_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:scrollbars="vertical"
        android:textSize="13sp" />

</LinearLayout>
