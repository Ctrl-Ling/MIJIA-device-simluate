<!--
  液态玻璃版型号库：搜索框、分类/品牌/排序全部药丸化，
  列表是一整块淡玻璃，行在里面再浮一层 —— 层次靠透明白的深浅拉开，不靠分割线。
  搜索框/搜索按钮跟筛选那几颗下拉按钮同一套几何：40dp 高、99dp 通圆弧，
  不再自己长成 44dp + 18dp 的方一点的样子。
  筛选区去掉「分类/品牌/排序」这些小字标签，按钮自己占满整行；
  每个区块之间的纵向间距统一 8dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_model_query"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill_input"
            android:gravity="center_vertical"
            android:hint="@string/hint_model_search"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_search_online"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="@string/action_search_online"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 收起后的筛选摘要：类型 / 品牌 / 数量 / 排序一行看完，点一下重新展开 -->
    <LinearLayout
        android:id="@+id/filter_summary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_input_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/filter_summary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/status_arrow_closed"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 筛选面板：分类 / 子类 / 品牌 / 统计 / 排序；下滑列表时整块收起，给列表让高度 -->
    <LinearLayout
        android:id="@+id/filter_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- 品牌：跟分类一样一颗下拉按钮，当前筛了谁写在按钮上；点开是全量多选弹窗。
         不再挂「品牌」小字，按钮自己撑满；品牌块挪到分类上面 —— 先定品牌，再在品牌里挑系列。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_pick_brand"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:text="@string/filter_all_brands"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_pick_cat"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:text="@string/filter_all_cats"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_pick_sub"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:text="@string/filter_pick_cat_first"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 型号列表排序：一进来就是上市时间倒序（新机在前），点按钮只切正序/倒序 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_sort_name"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_name"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_time"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_time"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 目录同步、导入导出这些都在右上角三点菜单里；这行只留型号数量 + 同步日期 -->
    <TextView
        android:id="@+id/library_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/model_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card_soft"
        android:padding="4dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/online_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:scrollbars="vertical"
        android:textColor="@color/ink_muted"
        android:textSize="13sp" />

</LinearLayout>
