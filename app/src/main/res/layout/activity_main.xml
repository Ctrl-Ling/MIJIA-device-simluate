<!--
  液态玻璃版主界面：底色由窗口背景（bg_liquid）铺，这里只叠玻璃面板。
  顶部三块（状态 / 设备库 / 总开关）都是 40dp 药丸：半透白 + 1dp 高光 + 99dp 全圆角，
  跟设备库的品牌筛选按钮同一套皮肤；下面才是列表卡（22dp）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="5dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">

    <!--
      顶部三块（状态 / 设备库 / 总开关）打包成一个整体：列表往下翻时整块收起，
      往上翻或已经到顶再下拉时放回来 —— 跟设备库筛选面板那套收放逻辑一致。
      计数行和列表不在这个壳里，收起来后它们直接顶上去。
    -->
    <LinearLayout
        android:id="@+id/top_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!--
      状态块：默认收起，只留一行摘要 + 右侧三角；点整行展开完整诊断信息。
      收起时整块是一颗 40dp 的 bg_glass_pill 药丸；展开时同一颗药丸长高，
      底、1dp 玻璃描边不变，圆角跟药丸「看起来的角」对齐（展开态走 bg_glass_pill_panel，20dp）。
      三块（状态 / 设备库 / 总开关）收起态的高度、底色、描边、圆角完全同款。
    -->
    <LinearLayout
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_pill"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/status_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/status_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_placeholder"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_toggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@string/status_arrow_closed"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:text="@string/status_placeholder"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 设备库入口：40dp 药丸，跟状态块、总开关、设备库品牌筛选按钮同高同皮；只留标题 + › -->
    <LinearLayout
        android:id="@+id/btn_open_library"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_model_library_entry"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/glyph_chevron"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_inject"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/label_master_switch"
        android:textColor="@color/ink"
        android:textSize="13sp" />
    </LinearLayout>

    <!--
      设备数 + 排序 + 新增，一行装完：排序原来占一整行、两颗大药丸太吃高度，
      现在缩成纯文字，紧挨在「新增设备」左边；不再单独占一行，列表多出一个按钮的高度。
      文字样式照抄左边的「列表 N 台 · 注入 M 台」：14sp、墨色、无底无框，只有按下时有水波。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/count_placeholder"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <!-- 排序字眼只有「名称 / 时间」两个字，方向交给右边那颗固定 12dp 的双箭头，
             文字宽度永远不变，切正序/倒序时按钮不会忽宽忽窄。
             左右内边距压到 4dp：这两颗是附属动作，宽度要省下来给左边的计数文字，
             不能让「列表 N 台 · 注入 M 台」被挤成省略号。 -->
        <TextView
            android:id="@+id/btn_sort_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clickable="true"
            android:drawablePadding="1dp"
            android:drawableEnd="@drawable/ic_sort_idle"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingLeft="4dp"
            android:paddingTop="8dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:text="@string/sort_name"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_sort_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clickable="true"
            android:drawablePadding="1dp"
            android:drawableEnd="@drawable/ic_sort_idle"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingLeft="4dp"
            android:paddingTop="8dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:text="@string/sort_time"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_add"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_add" />
    </LinearLayout>

    <!--
      列表块：配色和描边跟编辑页那张表单卡一致（65%→24% 白渐变 + 1dp 高光），
      圆角仍是列表自己的 22dp。大块面压淡后，里面那层半透白行才看得出边界。
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_list_faint"
        android:padding="4dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/hint_no_device"
        android:textColor="@color/ink_muted"
        android:textSize="14sp" />

</LinearLayout>
