<!--
  液态玻璃版主界面：底色由窗口背景（bg_liquid）铺，这里只叠玻璃面板。
  每块面板都是「半透白 + 大圆角 + 1dp 高光」，透出下面那层色斑。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">

    <!--
      状态块：默认收起，只留一行摘要 + 右侧三角；点整行展开完整诊断信息。
      收起时整块就是 56dp 一行，跟型号库入口、总开关三块保持同一高度和同一 26dp 圆角。
    -->
    <LinearLayout
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/status_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_status_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/status_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_placeholder"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_toggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@string/status_arrow_closed"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingLeft="14dp"
            android:paddingTop="2dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:text="@string/status_placeholder"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 型号库入口：固定 56dp 一行，跟状态块、总开关同高同圆角，只留标题 + › -->
    <LinearLayout
        android:id="@+id/btn_open_library"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_model_library_entry"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/glyph_chevron"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_inject"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/label_master_switch"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/count_placeholder"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_add" />
    </LinearLayout>

    <!-- 排序：点一下按该规则重排并落库（界面顺序 = 注入顺序）。
         不再挂左侧「排序」小字，两颗按钮自己撑满整行，标题占据的那点宽度全归按钮。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_sort_name"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_name"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_time"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_time"
            android:textSize="12sp" />
    </LinearLayout>

    <!--
      列表块：配色和描边跟编辑页那张表单卡一致（65%→24% 白渐变 + 1dp 高光），
      圆角仍是列表自己的 22dp。大块面压淡后，里面那层半透白行才看得出边界。
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_list_faint"
        android:padding="4dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/hint_no_device"
        android:textColor="@color/ink_muted"
        android:textSize="14sp" />

</LinearLayout>
