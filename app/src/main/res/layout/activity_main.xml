<!--
  液态玻璃版主界面：底色由窗口背景（bg_liquid）铺，这里只叠玻璃面板。
  每块面板都是「半透白 + 大圆角 + 1dp 高光」，透出下面那层色斑。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">

    <!--
      状态块：默认收起，只留一行摘要 + 右侧三角；点整行展开完整诊断信息。
      列表越用越长，这块展开时太占地方，收起来给列表让路。
    -->
    <LinearLayout
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_soft"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/status_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/status_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_placeholder"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_toggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@string/status_arrow_closed"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="4dp"
            android:text="@string/status_placeholder"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_inject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:text="@string/label_master_switch"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/count_placeholder"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_more_switches"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_more_switches" />

        <Button
            android:id="@+id/btn_add"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_add" />
    </LinearLayout>

    <!-- 排序：点一下按该规则重排并落库（界面顺序 = 注入顺序） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:text="@string/label_sort"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_name"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_name"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sort_time"
            style="@style/Widget.MijiaSim.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sort_time"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card_soft"
        android:padding="4dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/hint_no_device"
        android:textColor="@color/ink_muted"
        android:textSize="14sp" />

</LinearLayout>
